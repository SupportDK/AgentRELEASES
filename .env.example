# AGENT WPC — environment variables for MCP servers
#
# Copy this file to .env and fill in your real values:
#   cp .env.example .env
#
# NEVER commit your real .env file — it is git-ignored.

# GitHub classic PAT with `repo` scope.
# Create one at: https://github.com/settings/tokens
# Must be a CLASSIC token (ghp_...) — fine-grained tokens (github_pat_...)
# do not work with the GitHub MCP endpoint.
# Do not commit your real .env file.
GITHUB_PAT=
